    todo("tls-nv.tlsmsg.write_key_update")

// Whether this ServerHello is a HelloRetryRequest.
//
// The test is the 32 random bytes against RFC 8446 § 4.1.3's constant,
// compared in full.  A client that skipped it installs keys from a key
// share the server did not send.
pub fn is_hello_retry_request(sh: TlsServerHello) -> Bool []
    todo("tls-nv.tlsmsg.is_hello_retry_request")

// The 32-byte constant that marks a HelloRetryRequest, for a caller
// writing one.
pub fn hello_retry_random() -> Bytes []
    todo("tls-nv.tlsmsg.hello_retry_random")

// The version the peer actually selected, out of `supported_versions`.
//
// There is no accessor for the legacy version field.  A ServerHello
// with no `supported_versions` extension is a peer that is not speaking
// 1.3, and that is `TlsMsgExtensionMissing` rather than a version
// number a caller might act on.
pub fn selected_version(sh: TlsServerHello) -> Result<Int, TlsMsgFault> []
    todo("tls-nv.tlsmsg.selected_version")

// The SNI host a ClientHello carried, or `None`.
//
// `None` and not `""` for a hello with no SNI, because a server that
// treated the two the same serves its default certificate to a client
// that asked for a name it does not have.
pub fn server_name_of(ch: TlsClientHello) -> ?Str []
    todo("tls-nv.tlsmsg.server_name_of")

// Pick an ALPN protocol: the first of the server's supported list that
// the client offered.
//
// The SERVER's order wins, which is RFC 7301 § 3.2's rule and the
// opposite of what reading the client's list left to right gives.  A
// server that let the client choose has let the client downgrade it to
// whichever protocol it handles worst.
pub fn alpn_pick(offered: [Str], supported: [Str]) -> ?Str []
    todo("tls-nv.tlsmsg.alpn_pick")

// The content a CertificateVerify signature is over: 64 spaces, the
// role's label, a zero byte, then the transcript hash.
//
// The role is an argument and there is no default, because the two
// labels differ precisely so that a server's signature cannot be
// replayed as a client's — and a function that guessed would be a
// function that could guess wrong in the direction that costs
// something.
pub fn verify_context(role: TlsRole, transcript_hash: Bytes) -> Bytes []
    todo("tls-nv.tlsmsg.verify_context")

// Build a `server_name` extension.
pub fn server_name_extension(host: Str) -> Result<TlsExtension, TlsMsgFault> []
    todo("tls-nv.tlsmsg.server_name_extension")

// Build an `application_layer_protocol_negotiation` extension.
pub fn alpn_extension(protocols: [Str]) -> Result<TlsExtension, TlsMsgFault> []
    todo("tls-nv.tlsmsg.alpn_extension")

// Build a `key_share` extension from the entries a caller generated.
pub fn key_share_extension(entries: [TlsKeyShareEntry]) -> Result<TlsExtension, TlsMsgFault> []
    todo("tls-nv.tlsmsg.key_share_extension")

// Build the `supported_versions` extension that says TLS 1.3 and
// nothing else.
//
// Nothing else, on purpose: offering 1.2 beside it is what makes a
// downgrade something a middlebox can force, and this package does not
// implement 1.2 to fall back to.
pub fn supported_versions_extension(role: TlsRole) -> Result<TlsExtension, TlsMsgFault> []
    todo("tls-nv.tlsmsg.supported_versions_extension")

// What went wrong with a handshake message, in one line.
//
// A duplicate or misplaced extension names the extension, because
// "malformed ClientHello" against a real peer is a report nobody can
// act on.
//
// ```novo ignore
// use tlsmsg
//
// fn report(e: TlsMsgFault) -> Str
//     e.message()
// ```
impl Error for TlsMsgFault
    fn message(self) -> Str
        todo("tls-nv.tlsmsg.TlsMsgFault.message")
